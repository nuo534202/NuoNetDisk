# PostgreSQL
POSTGRES_DB=nuonetdisk
POSTGRES_USER=nuonetdisk
POSTGRES_PASSWORD=nuonetdisk_dev
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=nuonetdisk
MINIO_ROOT_PASSWORD=nuonetdisk_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
SERVER_PORT=8080
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
MAX_UPLOAD_SIZE=104857600
LOG_LEVEL=debug

# Rate Limits
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=100

# Recycle Bin
RECYCLE_BIN_EXPIRY=720h
RECYCLE_BIN_CLEANUP_INTERVAL=24h

# CORS
CORS_ALLOWED_ORIGINS=*
